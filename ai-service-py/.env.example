# ================= DeepSeek API 配置 =================
# 1. 去 https://platform.deepseek.com/ 注册账号并创建 API Key
# 2. 把下面的 sk-xxx 替换成你自己的 Key（保存为 .env 文件，不要把 .env 提交到 git）
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ================= 数据库配置 =================
# 默认 SQLite，零配置自动建表；后续切 PostgreSQL 时改成：
# DATABASE_URL=postgresql+asyncpg://postgres:1234@192.168.118.130:5432/ai-vector
DATABASE_URL=sqlite+aiosqlite:///./chat.db

# ================= 服务配置 =================
# 服务监听端口（前端直接访问，不经过 Java 网关）
SERVER_PORT=8086

# ================= DeepSeek API 配置 =================
# 1. 去 https://platform.deepseek.com/ 注册账号并创建 API Key
# 2. 把下面的 sk-xxx 替换成你自己的 Key（保存为 .env 文件，不要把 .env 提交到 git）
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ================= 数据库配置 =================
# 会话/消息存 MySQL chat_history 库（表：sessions / messages）
DATABASE_URL=mysql+aiomysql://root:123@192.168.118.130:3306/chat_history?charset=utf8mb4

# ================= 向量数据库 (PostgreSQL + pgvector) =================
# 存 job_category_vector / job_detail_vector 两张岗位向量表
# 真实库在 8.147.71.59:40086（见 a_fuchuang_2026/test_script/testing 的 application.yml），密码中的 @ 需 URL 编码为 %40
VECTOR_DATABASE_URL=postgresql://postgres:Mm85619562%40@8.147.71.59:40086/ai-vector

# ================= DashScope 文本嵌入 =================
# 必须用 text-embedding-v1（1536 维），与库里向量一致（DeepSeek 无 embedding API）
# 去 https://dashscope.console.aliyun.com/ 创建 API Key 后替换下面的 sk-xxx
DASHSCOPE_API_KEY=sk-你的key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v1
EMBEDDING_DIMENSIONS=1536
